{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile with phone, email, country, and progress stats",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User UID matching auth.uid" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "phoneNumber": { "type": "string", "description": "User contact phone number with country code" },
        "country": { "type": "string", "description": "Selected country" },
        "countryCode": { "type": "string", "description": "ISO or dialing prefix code" },
        "totalXp": { "type": "number", "description": "Accumulated experience points" },
        "streakDays": { "type": "number", "description": "Active daily engagement streak" },
        "completedCourses": { "type": "array", "items": { "type": "string" }, "description": "List of completed course IDs" },
        "role": { "type": "string", "enum": ["student", "mentor", "admin"], "description": "User role" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "phoneNumber", "country"]
    },
    "CourseProgress": {
      "title": "CourseProgress",
      "description": "Per-course progress tracking document",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID" },
        "courseId": { "type": "string", "description": "Course identifier" },
        "isCompleted": { "type": "boolean", "description": "Whether course is finished" },
        "progressPercent": { "type": "number", "description": "Lesson progress percentage" },
        "completedAt": { "type": "string", "format": "date-time" },
        "lastAccessedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "isCompleted"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles. Users can read and write their own profile."
    },
    "/users/{userId}/progress/{courseId}": {
      "schema": "CourseProgress",
      "description": "Course progress records belonging to a user."
    }
  }
}
