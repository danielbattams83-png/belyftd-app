rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public media used by the home page and audio players.
    match /App Videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /App Audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Keep all other Storage paths private by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
