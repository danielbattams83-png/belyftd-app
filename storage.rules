rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public media used by the home page and audio players.
    match /App_Videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /App_Audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Course media follows course-content/{moduleId}/{unitId}/{mediaType}/{avatarId}.{ext}.
    // The subscriptionTier custom claim is issued by trusted backend code.
    match /course-content/{moduleId}/{unitId}/{mediaType}/{avatarId} {
      allow read: if request.auth != null
        && request.auth.token.subscriptionTier is number
        && request.auth.token.subscriptionTier >= 1
        && (mediaType == 'audio' || mediaType == 'video');
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Keep all other Storage paths private by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
