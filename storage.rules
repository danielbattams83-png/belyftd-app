rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public media used by the home page and audio players.
    match /App_Videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /App_Audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /course-content/{moduleId}/{unitId}/{mediaType}/{fileName} {
      function unitMinTier() {
        return firestore.get(
          /databases/(default)/documents/modules/$(moduleId)/units/$(unitId)
        ).data.minTier;
      }

      function hasRequiredTier(minTier) {
        return request.auth != null
          && request.auth.token.subscriptionTier is int
          && request.auth.token.subscriptionTier in [1, 2, 3]
          && minTier is int
          && minTier in [1, 2, 3]
          && request.auth.token.subscriptionTier >= minTier;
      }

      allow read: if mediaType in ['audio', 'video']
        && fileName.matches('^[A-Za-z0-9_.-]+\\.[A-Za-z0-9]+$')
        && hasRequiredTier(unitMinTier());
      allow write: if false;
    }

    // Keep all other Storage paths private by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
