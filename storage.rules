rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public media used by the home page and audio players.
    match /App_Videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /App_Audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /course-content/{moduleId}/{unitId}/{mediaType}/{fileName} {
      function hasModuleAccess() {
        return request.auth != null
          && request.auth.token.subscriptionTier in [1, 2, 3, 4]
          && moduleId.matches('module-[1-9][0-9]*')
          && request.auth.token.subscriptionTier >=
            (moduleId in ['module-1', 'module-2', 'module-3', 'module-4', 'module-5'] ? 1 :
            (moduleId in ['module-6', 'module-7', 'module-8', 'module-9', 'module-10'] ? 2 : 3));
      }

      allow read: if mediaType in ['audio', 'video']
        && fileName.matches('^[A-Za-z0-9_.-]+[.][A-Za-z0-9]+$')
        && hasModuleAccess();
      allow write: if false;
    }

    // Super-admin CMS uploads. Student clients never receive this custom claim.
    match /course-content/videos/{moduleId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.superAdmin == true
        && moduleId.matches('module-[1-9][0-9]*')
        && fileName.matches('^unit-[1-9][0-9]*[.]mp4$')
        && request.resource.size < 1024 * 1024 * 500
        && request.resource.contentType.matches('video/.*');
    }

    match /course-content/audio/{moduleId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.superAdmin == true
        && moduleId.matches('module-[1-9][0-9]*')
        && fileName.matches('^unit-[1-9][0-9]*[.]mp3$')
        && request.resource.size < 1024 * 1024 * 100
        && request.resource.contentType.matches('audio/.*');
    }

    match /admin-media/{scope}/{ownerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.superAdmin == true
        && scope in ['mentors', 'brand']
        && ownerId.matches('^[a-z0-9][a-z0-9_-]{0,79}$')
        && fileName.matches('^[A-Za-z0-9_.-]+[.][A-Za-z0-9]+$')
        && request.resource.size < 1024 * 1024 * 500
        && request.resource.contentType.matches('(image|video|audio)/.*');
    }

    // Keep all other Storage paths private by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
