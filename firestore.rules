rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify user authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasSubscriptionTier(minTier) {
      return isAuthenticated()
        && request.auth.token.subscriptionTier is int
        && request.auth.token.subscriptionTier in [1, 2, 3, 4]
        && request.auth.token.subscriptionTier >= minTier;
    }

    match /superAdminSessions/{sessionId} {
      allow read, write: if false;
    }

    match /superAdminAttempts/{attemptId} {
      allow read, write: if false;
    }

    // User profile access rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Nested user progress subcollection
      match /progress/{courseId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /courses/{courseId} {
      allow read: if true;
    }

    // Public catalog contains titles, ordering, and availability only; lesson text stays gated.
    match /moduleCatalog/{moduleId} {
      allow read: if true;
      allow write: if false;
    }

    match /modules/{moduleId}/units/{unitId} {
      allow read: if moduleId.matches('module-[1-9][0-9]*')
        && ((request.auth != null && request.auth.token.superAdmin == true)
          || hasSubscriptionTier(moduleId in ['module-1', 'module-2', 'module-3', 'module-4', 'module-5'] ? 1 :
            (moduleId in ['module-6', 'module-7', 'module-8', 'module-9', 'module-10'] ? 2 : 3)));
      allow write: if request.auth != null
        && request.auth.token.superAdmin == true
        && moduleId.matches('module-[1-9][0-9]*')
        && unitId.matches('unit-[1-9][0-9]*');
    }

    match /adminMedia/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.token.superAdmin == true;
    }

    match /sponsorProfiles/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /dailyAffirmations/{affirmationId} {
      allow read: if true;
    }

    match /mentors/{mentorId} {
      allow read: if true;
    }

    match /partnerships/{partnershipId} {
      allow read: if true;
    }

    match /partners/{partnerId} {
      allow read: if true;
      // Mutations go through superAdminSavePartner; standard app sessions grant no admin rights.
      allow write: if false;
    }
  }
}
