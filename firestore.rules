rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify user authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasSubscriptionTier(minTier) {
      return isAuthenticated()
        && request.auth.token.subscriptionTier is int
        && request.auth.token.subscriptionTier in [1, 2, 3]
        && request.auth.token.subscriptionTier >= minTier;
    }

    // User profile access rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Nested user progress subcollection
      match /progress/{courseId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /courses/{courseId} {
      allow read: if true;
    }

    match /modules/{moduleId}/units/{unitId} {
      allow read: if resource.data.minTier is int
        && resource.data.minTier in [1, 2, 3]
        && hasSubscriptionTier(resource.data.minTier);
    }

    match /sponsorProfiles/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /dailyAffirmations/{affirmationId} {
      allow read: if true;
    }

    match /mentors/{mentorId} {
      allow read: if true;
    }

    match /partnerships/{partnershipId} {
      allow read: if true;
    }
  }
}
